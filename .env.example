# HistAR Mobile — copy to .env (do not commit secrets)
# All three must be https. Mobile calls the API directly (no CORS origin).
# WEB_APP_URL is the FE host for /privacy, verify-email, and the full 360 WebView.
API_BASE_URL=https://histar-postgre.onrender.com
# Cloudflare R2 public base after MEDIA_R2.md probe is 200 (no trailing slash).
MEDIA_BASE_URL=https://media.timelens.asia
WEB_APP_URL=https://fe-lake-five.vercel.app
# Firebase Console → Project settings → Web app → OAuth client ID (for idToken on Android/iOS)
GOOGLE_WEB_CLIENT_ID=252881479461-0ql2b9k89pabma7atb7556sldm5hgi04.apps.googleusercontent.com
